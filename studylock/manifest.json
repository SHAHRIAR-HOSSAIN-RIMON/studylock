{
  "manifest_version": 3,
  "name": "StudyLock: Pomodoro Timer & Site Blocker",
  "short_name": "StudyLock",
  "version": "1.0.0",
  "description": "A Pomodoro study timer that blocks distracting sites while you focus. No account, no tracking: everything stays on your device.",
  "minimum_chrome_version": "121",
  "permissions": ["storage", "alarms", "notifications", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["shared.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StudyLock",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js", "shared.js", "style.css", "icons/icon128.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "studylock@shahriar-hossain-rimon.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
